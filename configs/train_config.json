{
  "features": {
    "transTable": true,
    "dirichletNoise": true,
    "googleDrive": false,
    "FPU": -1.0,
    "detailedStat": false
  },

  "path": {
     "model_path": "../models/",
     "model_prefix": "K",
     "drive_path": "../drive/MyDrive",
     "data_path": "../data/"
  },

  "rating": {
      "init_K": 32.0,
      "init_rating": 0.0
  },

  "board": {
    "komi": 2.5,
    "neutrals": [[4, 4]]
  },

  "dirichlet_noise": {
    "epsilon": 0.2,
    "alpha": 0.15
  },

  "mcts": {
    "mode": "playout",
    "time": 10,
    "nPlayout": 600,
    "cPuct": 1.5,
    "temp": 1.0,
    "minVisitRatio": 0.005,
    "fullSearchProb": 0.25,
    "fastPlayout": 300
  },

  "nn": {
    "batchSize": 512,
    "inputChannel": 23,
    "numHiddenBlock": 10
  },

  "cache": {
    "log_tableSize": 20,
    "log_mutexPoolSize": 10 
  },

  "train": {
    "epochs": 1,
    "check_freq": 960,
    "compare_game_cnt": 96,
    "compare_thread_num": 12,
    "search_thread_num": 4,
    "train_wait_time": 50000,
    "save_freq": 96,
    "capacity": 300000,
    "trainStartPoint": 20000,
    "windowFraction": 0.25,
    "valueQMix": 0.5,
    "fallbackWinrate": 0.25,
    "lrPatience": 10,
    "lrImprovementWinrate": 0.55,
    "initialLearningRate": 0.0001
  }
}